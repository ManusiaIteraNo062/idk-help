[gd_resource type="Resource" script_class="Mission" format=3]

[ext_resource type="Script" path="res://scripts/data/mission.gd" id="1_m"]
[ext_resource type="Script" path="res://scripts/data/enemy_wave.gd" id="2_wave"]
[ext_resource type="Script" path="res://scripts/data/enemy_type.gd" id="3_et"]
[ext_resource type="Resource" path="res://data/enemies/hpa_seaside.tres" id="e_hpa_seaside"]
[ext_resource type="Resource" path="res://data/enemies/sloppy_altered.tres" id="e_sloppy_altered"]

[sub_resource type="Resource" id="Wave_0"]
script = ExtResource("2_wave")
enemies = Array[ExtResource("3_et")]([ExtResource("e_hpa_seaside"), ExtResource("e_sloppy_altered"), ExtResource("e_sloppy_altered"), ExtResource("e_sloppy_altered")])

[resource]
script = ExtResource("1_m")
